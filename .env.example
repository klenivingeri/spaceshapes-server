# Copie para .env (ignorado pelo git) e preencha. No Render, configure estas variáveis no painel do serviço.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
MONGODB_DB=quadrix
# Segredo que assina as sessões de quem entra com o Google (qualquer texto longo e aleatório).
SESSION_SECRET=
GOOGLE_CLIENT_ID=
